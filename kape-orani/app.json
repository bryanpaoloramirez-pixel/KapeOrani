{
  "expo": {
    "name": "KapeOrani",
    "slug": "kapeorani",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/KAPEORANI LOGO.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2A2723"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/KAPEORANI LOGO.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kailangan namin ang lokasyon mo para hanapin ang malapit na kapehan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/KAPEORANI LOGO.png",
        "backgroundColor": "#2A2723"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.kapeorani"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "eab3a9b8-3e9d-4623-a2eb-fd243196f16a"
      }
    },
    "owner": "bryan.ramirez10"
  }
}
